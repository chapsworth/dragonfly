{
  "name": "Vendor",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Vendor company name"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "vendor_type": {
      "type": "string",
      "enum": [
        "grower",
        "processor",
        "distributor",
        "packaging",
        "equipment",
        "other"
      ],
      "description": "Type of vendor"
    },
    "products_supplied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of products they supply"
    },
    "license_number": {
      "type": "string",
      "description": "State license number"
    },
    "license_expiry": {
      "type": "string",
      "format": "date"
    },
    "payment_terms": {
      "type": "string",
      "description": "e.g., Net 30, COD"
    },
    "minimum_order": {
      "type": "number"
    },
    "rating": {
      "type": "number",
      "description": "Vendor rating 1-5"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "last_order_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending"
      ],
      "default": "active"
    }
  },
  "required": [
    "company_name"
  ]
}