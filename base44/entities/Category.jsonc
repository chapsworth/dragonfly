{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "display_order": {
      "type": "number",
      "description": "Order in which category appears"
    },
    "icon_name": {
      "type": "string",
      "description": "Lucide icon name"
    },
    "gradient": {
      "type": "string",
      "description": "Tailwind gradient classes"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ]
}